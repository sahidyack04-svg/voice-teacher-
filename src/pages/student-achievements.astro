---
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";

const achievements = [
  {
    title: "Student Achievement 1",
    body: "Celebrating student success across academics, sports and creative projects.",
    src: "/images/student%20achievement%201.jpg",
    alt: "Student Achievement Image 1"
  },
  {
    title: "Student Achievement 2",
    body: "Outstanding performances and collaborative learning highlighted in our school community.",
    src: "/images/student%20achievement%202.jpg",
    alt: "Student Achievement Image 2"
  },
  {
    title: "Student Achievement 3",
    body: "Recognition for innovation, leadership and exemplary student projects.",
    src: "/images/student%20achievement%203.png",
    alt: "Student Achievement Image 3"
  }
];
---

<Base
  title="Student Achievements | WWIS Trichy"
  description="Discover how WWIS celebrates student achievements across storytelling, culinary arts, creativity, digital learning, and product design."
  pageType="AboutPage"
>
  <PageHero
    eyebrow="Student Achievements"
    title="Every achievement is a meaningful moment of growth"
    text="At WWIS, achievements are celebrated as evidence of confidence, curiosity, perseverance, and joyful progress across academics and talents."
    primaryLabel="Back to About Us"
    primaryHref="/about"
    secondaryLabel="Explore Daily Activities"
    secondaryHref="/daily-activities"
  />

  <section class="achievement-list">
    {achievements.map((item, index) => (
      <article class:list={["achievement-card fade-up", index % 2 === 1 && "achievement-card--reverse"]}>
        <div class="achievement-card__content">
          <p class="eyebrow">{item.title}</p>
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </div>
        <div class="achievement-card__media">
          <ImagePlaceholder src={item.src} alt={item.alt} label={item.title} aspectRatio="4 / 3" />
        </div>
      </article>
    ))}
  </section>

  <section class="achievement-categories soft-band fade-up">
    <div class="categories-grid">
      <article class="category-card">
        <h3>Storytelling and Reading Confidence</h3>
        <p>Fostering language skills, confidence and imagination through guided storytelling and reading activities.</p>
      </article>
      <article class="category-card">
        <h3>Culinary Creativity and Life Skills</h3>
        <p>Hands-on culinary experiences that build practical life skills, creativity and teamwork.</p>
      </article>
      <article class="category-card">
        <h3>Creative Expression and Artistic Growth</h3>
        <p>Encouraging artistic exploration and self-expression through a variety of creative media and projects.</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .achievement-list {
    display: grid;
    gap: 24px;
  }

  .achievement-card {
    align-items: center;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.8fr);
    padding: 24px;
  }

  .achievement-card--reverse {
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1fr);
  }

  .achievement-card--reverse .achievement-card__media {
    order: 2;
  }

  .achievement-card__content {
    display: grid;
    gap: 10px;
  }

  @media (max-width: 800px) {
    .achievement-card,
    .achievement-card--reverse {
      grid-template-columns: 1fr;
    }

    .achievement-card--reverse .achievement-card__media {
      order: 0;
    }
  }

  .achievement-categories { padding: 32px 0; }
  .categories-grid { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .category-card { background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-sm); text-align: center; }
  .category-card h3 { color: var(--royal-blue); font-size: 1.05rem; margin-bottom: 8px; }
  .category-card p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {
    .categories-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .categories-grid { grid-template-columns: 1fr; }
  }

</style>
